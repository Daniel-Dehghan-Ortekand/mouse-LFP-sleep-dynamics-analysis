%% amplitude compare


% Define paths
pathsAmp = dir('*/sepratedSpindles*');
[nRaws, ~] = size(pathsAmp);

meanAmpGlobindi = zeros(1,nRaws);

meanAmpLocindi = zeros(1,nRaws);
% GlobAmpcat = [];
% LocAmpcat = [];
count = 0;
for k = 1:nRaws
%     filename = strcat(pathsAmp(k).folder, filesep, pathsAmp(k).name); % Use filesep instead of just '/'
%     data = load(filename);
%     Gobal =['data.sepratedSpindles',num2str(sessionNumber(k)),'.globalPeaks'];
%     GlobalData = eval(Gobal);
%     GlobAmpcat = [GlobAmpcat , GlobalData(1,:)];
GlobAmpcat = [];
LocAmpcat = [];
    load (['sepratedSpindles' num2str(k) '.mat'])
    ref = getRefSpindleChannel(sepratedSpindles.sepratedSpindles.referencChannel(1,1) );
     GlobalDatazscored= sepratedSpindles.sepratedSpindles.globalSPindles (2,ref);
     LocalDataZscored = sepratedSpindles.sepratedSpindles.localSPindles (2,ref);
      GlobAmp= GlobalDatazscored{1,1};
    LocAmp = LocalDataZscored{1,1};
    GlobAmpcat = GlobAmp(1,:);

    meanAmpGlobindi(k) = mean(GlobAmp(1,:));
%     Local =['data.sepratedSpindles',num2str(sessionNumber(k)),'.LocalPeaks'];
%     LocalData = eval(Local);
    meanAmpLocindi(k) = mean(LocAmp(1,:));
    LocAmpcat = LocAmp(1,:);


% t-test
meanAmpGlob = mean(GlobAmpcat);
meanAmpLoc = mean(LocAmpcat);


% Perform t-test
[h, p] = ttest2(GlobAmpcat , LocAmpcat);

% Display results
if isnan(h)
    disp('Error in performing t-test.');
elseif h
    disp(['mean firing rate for Global is ' num2str(meanAmpGlob)]);
    disp(['mean firing rate for Local is ' num2str(meanAmpLoc)]);
    fprintf('There is a significant difference between the means.\n');
    count = count+1;
    ch_mag(k) = k;
else
    disp(['mean firing rate for Gloal is ' num2str(meanAmpGlob)]);
    disp(['mean firing rate for Local is ' num2str(meanAmpLoc)]);
    fprintf('There is no significant difference between the means.\n');
end
fprintf('p-value: %.4f\n', p);


