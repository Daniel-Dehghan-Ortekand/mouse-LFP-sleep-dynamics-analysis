%      GlobalDatazscored= sepratedSpindles.sepratedSpindles.globalSPindles (2,ref);
%      LocalDataZscored = sepratedSpindles.sepratedSpindles.localSPindles (2,ref);
      GlobPAC= circ_mean(PAC_features.angleBig );
