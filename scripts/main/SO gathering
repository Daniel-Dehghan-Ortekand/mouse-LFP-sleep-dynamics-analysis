
%% Data organization and preprocessing
% This script loads and reorganizes sleep-related neural data from multiple
% recording sessions, including slow oscillation (SO) detection, spindle
% detection, filtered thalamic signals, spike data, and SO delay/ratio
% information. The data are renamed and saved in a session-wise format for
% subsequent analysis. It also stores the channels excluded from analysis
% for each recording session.

clc 
close all 
clear 
%% find data 
SOdata = cell(1,18);
pathsSoDetected = dir('*/SOdetected*');
SOdetected = cell(1,18);
pathsDelayAndRatio = dir('*/SOreferenceChannelDelayAndRatioFrom0.5to4Hz*');
SOreferenceChannelDelayAndRatioFrom5to4Hz = cell(1,18);
pathsDelayAndRatio = dir('*/SOreferenceChannelDelayAndRatioFrom0.5to10Hz*');
SOreferenceChannelDelayAndRatioFrom5to10Hz = cell(1,18);


for k=1:size(SOdata,2)

    filename = strcat(pathsSoDetected(k).folder, filesep, pathsSoDetected(k).name); % Use filesep instead of just '/'
    data = load(filename);
    SOdetected = data;
    save(['SOdetected' num2str(k)], 'SOdetected', '-v7.3');
    clear SOdetected
        clear data

end
