
%% Spike-based firing rate modulation analysis
% This function quantifies the modulation of neuronal firing activity around
% specified neural events. It first constructs event-aligned spike rasters
% and calculates the time-resolved firing rate. A surrogate distribution is
% then generated by shuffling event locations within temporal segments and
% is used to z-score the observed firing rate. The modulation index (MI) is
% calculated as the difference between the maximum and minimum normalized
% firing rates within the specified MI time window. The function optionally
% plots the resulting normalized firing-rate modulation. Supporting
% functions perform event-aligned raster construction, firing-rate
% estimation, and surrogate-based normalization.



function [MI, f_rate ,rate, center,data_raster] = ModulationIndex(data, events, fs, range, mi_range, bin, plot)
%SPIKEDENSITY Summary of this function goes here
%   Detailed explanation goes here

data_raster = calc_raster(data, events, fs, range);
[rate, center] = calc_rate(data_raster, fs, range, bin);

% p = mean_test(rate, data, events, range, fs, bin, 1000);

means = calc_zscore(data, events, mi_range, fs, bin, 100);

f_rate = (rate-mean(means))/std(means);

rate_rage = center >= range(1)/2 & center <= range(2)/2;
MI = max(f_rate(rate_rage)) - min(f_rate(rate_rage));

if plot
    bar(center, f_rate)
    xlim(range)
end

% figure
% tiledlayout(3, 1)
% 
% nexttile
% bar(center, rate)
% xlim(range)
% ylabel("True")
% 
% nexttile
% bar(center, s_rate(ind))
% xlim(range)
% ylabel("surrogate")
% 
% nexttile
% bar(center, f_rate)
% xlim(range)
% ylabel("res")


end

function means = calc_zscore(data, events, range, fs, bin, count)

event = zeros(size(data));
event(events) = 1;

l = floor(diff(range)*fs);
loop = floor(length(event)/l);
means = zeros(1, count);

for k = 1:count
    for i = 1:loop
        event(1+(i-1)*l:i*l) = shuffle(event(1+(i-1)*l:i*l), 2);
    end
    event(1+i*l:end) = shuffle(event(1+i*l:end), 2);

    events = find(event == 1);

    data_raster = calc_raster(data, events, fs, range);
    [r, ~] = calc_rate(data_raster, fs, range, bin);

    means(k) = mean(r);
end

end

function data_raster = calc_raster(data, events, fs, range)

ind = (round(range(1)*fs) : round(range(2)*fs));
data_raster = false(length(events), length(ind));

events(events < range(2)*fs) = [];
events(events > length(data) + range(1)*fs) = [];

% bad_ind = [];
for i = 1:length(events)
    data_raster(i, :) = data(ind + events(i));
    
%     if ~any(data_raster(i, :))
%         bad_ind = [bad_ind i];
%     end
end

% data_raster(bad_ind, :) = [];

end

function [rate, center] = calc_rate(data_raster, fs, range, bin)

[~, c] = ind2sub(size(data_raster), find(data_raster == 1));
spikes = (c-1)/fs+range(1);

[N,edges] = histcounts(spikes, (range(1):bin:range(2)));
center = (edges(2:end)+edges(1:end-1))/2;
rate = N/size(data_raster, 1)/bin;
rate = smoothdata(rate, 'gaussian', 5);

end

function p = mean_test(rate, data, events, range, fs, bin, count)

main_mean = mean(rate);

means = calc_zscore(data, events, range, fs, bin, count);
means_sorted = sort(means);

end


