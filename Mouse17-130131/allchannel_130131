%% Loading raw LFP data and extracting NREM episodes
% This script loads the session information and raw multichannel EEG
% recording from the Mouse17-130131 experiment and determines the number
% of recorded channels and sampling frequency.
%
% The complete EEG recording is loaded from the .eeg file, transposed, and
% converted to double precision for subsequent processing. The resulting
% multichannel EEG data are saved as a MAT file for further analysis.
%
% Predefined NREM/SWS time intervals are used to create a logical index
% corresponding to all NREM episodes. The EEG samples within these
% intervals are extracted across all channels and saved separately,
% together with the corresponding NREM/SWS episode time intervals, for
% subsequent sleep spindle analysis.

clear 
clc
close all
changeCurrentFolder('D:\daniel\Mouse17-130131')
%% read the .EEG file and save all channel

load Mouse17-130131.sessionInfo.mat
nChannels = sessionInfo.nChannels;
fs=1250;

thal_allchanel_Mouse17_130131_new = bz_LoadBinary('Mouse17-130131.eeg','nChannels',nChannels,'frequency',fs);

save thal_allchanel_Mouse17-130131 -v7.3
OriginalData = thal_allchanel_Mouse17_130131_new;
%% creat NREM EPISOD

ch_number= nChannels;
OriginalData=transpose(OriginalData);
OriginalData=double(OriginalData);

