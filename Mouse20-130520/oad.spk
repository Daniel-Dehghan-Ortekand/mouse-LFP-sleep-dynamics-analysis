%% Spike and LFP extraction from selected recording intervals
% This script loads the 1250 Hz EEG recording and extracts selected
% thalamic/hippocampal channels across predefined NREM time intervals.
% Spike times from multiple .res files are converted from 20 kHz to the
% 1250 Hz EEG sampling rate, aligned to the corresponding LFP time vector,
% and converted into binary multi-unit activity (MUA) signals.
% The extracted channel signals and MUA data are saved separately for
% subsequent spike-LFP and neuronal activity analyses.

% % 17-130128.res.1
Data = bz_LoadBinary('F:\my data\th-hipp\Mouse20-130520\Mouse20-130520.eeg','nChannels',76,'frequency',1250);
fs=1250;
ch33=double(Data(:,33));
T1=[1;374;1171;1635;2056;2432;2964;3522;4098;5689;6255;6474;6856;10120;10974;11374;11565;12652;13222;14770;15252;15547;15860;16100;18351];
T2=[201;1079;1535;2020;2246;2945;3275;4076;4244;6226;6429;6707;7191.90000000000;10917;11290;11535;11740;13104;13851;15201;15494;15781;15999;16162;19228];
[Ch69] =buz_channle(T1,T2,fs,ch69);
ch34=double(Data(:,34));
[Ch34] =buz_channle(T1,T2,fs,ch34);
ch35=double(Data(:,35));
[Ch35] =buz_channle(T1,T2,fs,ch35);
ch36=double(Data(:,36));
[Ch36] =buz_channle(T1,T2,fs,ch36);
ch37=double(Data(:,37));
[Ch37] =buz_channle(T1,T2,fs,ch37);
ch38=double(Data(:,38));
[Ch38] =buz_channle(T1,T2,fs,ch38);
ch39=double(Data(:,39));
[Ch39] =buz_channle(T1,T2,fs,ch39);
ch40=double(Data(:,40));
[Ch40] =buz_channle(T1,T2,fs,ch40);
L=ch69;
time=1/fs:1/fs:(length(L))/fs;
Spiketime.res=load ('Mouse20-130520.res.9','-ascii');
spkt=Spiketime.res/20000;% spkt0(EL) is time of spike in 20000 sample rate 
IND1 = nearestpoint(spkt,time,'nearest');% IND(EL) is the nearest sample of 1250 sample rate to each spike
mua9=zeros(1,length(time));
mua9(IND1)=1; % mua(EL) is a time vector that the spike times are 1 and the others are 0
ts=time(IND1);% ts(EL) is time of spikes in 1250 sample rate
[Mua9] =buz_channle(T1,T2,fs,mua9');
save Ch33.mat Ch33
save Ch34.mat Ch34
save Ch35.mat Ch35
save Ch36.mat Ch36
save Ch37.mat Ch37
save Ch38.mat Ch38
save Ch39.mat Ch39
save Ch69.mat Ch69
save Mua9.mat Mua9
% plot(time,ch8,'b',time,mua1*10^2.5,'r');

