%% Loading raw EEG data and extracting NREM episodes
% This script loads the session information and raw multichannel EEG
% recording from the Mouse20-130515 experiment and determines the number
% of recorded channels and sampling frequency.
%
% The complete EEG recording is loaded from the .eeg file and saved as a
% MAT file for subsequent processing. The data are then transposed and
% converted to double precision for further analysis.
%
% Predefined NREM/SWS time intervals are used to create a logical index
% corresponding to all NREM episodes. The EEG samples within these
% intervals are extracted across all channels and saved separately,
% together with the corresponding NREM episode time intervals, for
% subsequent sleep spindle analysis.

clear 
clc
close all
changeCurrentFolder('D:\daniel\Mouse20-130515')
%% read the .EEG file and save all channel

load Mouse20-130515.sessionInfo.mat
nChannels = sessionInfo.nChannels;
fs=1250;

thal_allchanel_Mouse20_130515_new = bz_LoadBinary('Mouse20-130515.eeg','nChannels',nChannels,'frequency',fs);

save thal_allchanel_Mouse20-130515 -v7.3
OriginalData = thal_allchanel_Mouse20_130515_new;
%% creat NREM EPISOD

ch_number= nChannels;
OriginalData=transpose(OriginalData);
OriginalData=double(OriginalData);

SwsTime = [34	460
655	1282
1324	1444
1483	1739
1884	2099
2144	2303
