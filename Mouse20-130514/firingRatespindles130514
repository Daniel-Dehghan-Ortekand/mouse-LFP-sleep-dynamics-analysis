shankNumHip = spikes.shankID (length(spikes.shankID)-length(tempspike)+1:length(spikes.shankID));
SpikesBaseOnLocation.Hipocamp = spikes_swsHip;
SpikesBaseOnLocation.Thalamus = spikes_swsThal;
SpikesBaseOnLocation.ThalamousshankIDs = shankNum;
SpikesBaseOnLocation.HipocampshankIDs = shankNumHip;
save SpikesBaseOnLocation130514.mat SpikesBaseOnLocation

%%
fs=1250;
temp = [];
for i=1:size(spikes_sws,1)
    sp = find(spikes_sws(i,:)==1);
    FR = length(sp)/(length(spikes_sws(i,:))/fs);
    if FR<0.5
        temp = [temp i];
    end
