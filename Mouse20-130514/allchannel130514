%% Loading raw LFP data and extracting NREM episodes
% This script loads the session information and raw multichannel EEG
% recording from the Mouse20-130514 experiment and determines the number
% of recorded channels and sampling frequency.
%
% The complete EEG recording is loaded from the .eeg file, transposed, and
% converted to double precision for subsequent processing and saved as a
% MAT file.
%
% Predefined NREM/SWS time intervals are used to create a logical index
% corresponding to all NREM episodes. The EEG samples within these
% intervals are extracted across all channels and saved separately,
% together with the corresponding NREM/SWS episode time intervals, for
% subsequent sleep spindle analysis.

clear 
clc
close all
changeCurrentFolder('D:\daniel\Mouse20-130514')
%% read the .EEG file and save all channel

load Mouse20-130514.sessionInfo.mat
nChannels = sessionInfo.nChannels;
fs=1250;

thal_allchanel_Mouse20_130514_new = bz_LoadBinary('Mouse20-130514.eeg','nChannels',nChannels,'frequency',fs);

save thal_allchanel_Mouse20-130514 -v7.3
OriginalData = thal_allchanel_Mouse20_130514_new;
%% creat NREM EPISOD

ch_number= nChannels;
OriginalData=transpose(OriginalData);
OriginalData=double(OriginalData);

SwsTime = [145	668
842	1125
1363	2124
2305	2703
2773	2936
3083	3296
3348	3551
3613	3679
3832	3968
8033	8211
8510	9242
9422	10164
10349	10772
10820	11145
11274	11526
11610	11770
11893	12384
13113	13225
13561	13916
14064	14871];

SWSpacket_num = size(SwsTime,1);


SWS_ind = false(1, length(OriginalData));
for i=1:SWSpacket_num
%     start_sample = round(sws(i,1)*fs);
%     stop_sample = round(sws(i,2)*fs);
    start_time = round(SwsTime(i,1)*fs);
    stop_time = round(SwsTime(i,2)*fs);
    SWS_ind(start_time:stop_time) = 1;
end
SWS_episode = OriginalData(:,SWS_ind);

save SWS_episode_130514.mat  SWS_episode -v7.3
save Sws_Time_130514.mat    SwsTime
