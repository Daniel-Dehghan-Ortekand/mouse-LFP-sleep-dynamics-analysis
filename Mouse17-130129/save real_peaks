%% Loading and organizing real spindle peak data
% This script loads the detected real sleep spindle peak data separately
% for each of the 63 thalamic channels from the Mouse17-130129 experiment.
%
% The real spindle peak data from each channel are stored in a cell array,
% preserving the channel-specific spindle peak information for subsequent
% analysis.
%
% The complete collection of real spindle peak data from all 63 channels
% is then saved as a MAT file for further analysis.

clc 
clear 
close all 
%%

% pathsthal = dir('*/thal_spindles_ch*');


for k=1:63
% 
%     filename = strcat(pathsthal(k).folder, filesep, pathsthal(k).name); % Use filesep instead of just '/'
%     data = load(filename);
       data= load(['real_peaks_130129_' num2str(k)]); 
      real_peaks{k} = data;
%     save(['thal_spindles' num2str(k)], 'thal_spindles', '-v7.3');
%         clear data

end
save real_peaks7.mat real_peaks
