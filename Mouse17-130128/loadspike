%% Extracting thalamic/hippocampal channels and multi-unit activity during NREM episodes
% This script loads the 70-channel EEG recording from the Mouse17-130202
% experiment and extracts selected channels corresponding to different
% recording groups. For each group, the selected EEG channels are processed
% together with predefined time intervals using the buz_channle function.
%
% Spike times from nine recorded units are loaded from the corresponding
% .res files, converted from the original 20 kHz sampling rate to seconds,
% and mapped to the nearest samples of the 1250 Hz EEG recording. Each spike
% train is converted into a binary multi-unit activity (MUA) time series.
% The MUA signals are then restricted to the same predefined time intervals
% as the EEG channels.
%
% The processed channel signals and MUA signals are saved separately as MAT
% files for subsequent analysis. A final plot is used to visualize an EEG
% channel together with its corresponding MUA activity and an additional
% hippocampal channel.

% % 17-130202.res.1
Data = bz_LoadBinary('I:\my data\th-hipp\Mouse17-130202\Mouse17-130202.eeg','nChannels',70,'frequency',1250);
fs=1250;
ch64=double(Data(:,64));
T1=[1237;1661;1978;2150;2384;2534;2902;3896;4135;4345;4725;4814;6752;7146;10682;11402;11908;12244;12766;13049;13310;13788;13947;14212;14575;14936;15351;17761;18078;18369;18898;19227;19471;20116;20824];
T2=[1655;1766;2135;2223;2453;2714;3333;4065;4291;4434;4795;4893;7079;7404;11333;11837;12002;12751;12990;13172;13703;13918;14212;14278;14836;15303;15478;18046;18175;18787;19221;19308;19776;20632;21127];
[Ch64] =buz_channle(T1,T2,fs,ch64);
ch57=double(Data(:,57));
[Ch57] =buz_channle(T1,T2,fs,ch57);
ch63=double(Data(:,63));
[Ch63] =buz_channle(T1,T2,fs,ch63);
ch58=double(Data(:,58));
[Ch58] =buz_channle(T1,T2,fs,ch58);
ch62=double(Data(:,62));
[Ch62] =buz_channle(T1,T2,fs,ch62);
ch59=double(Data(:,59));
[Ch59] =buz_channle(T1,T2,fs,ch59);
ch61=double(Data(:,61));
[Ch61] =buz_channle(T1,T2,fs,ch61);
ch60=double(Data(:,60));
[Ch60] =buz_channle(T1,T2,fs,ch60);
L=ch64;
time=1/fs:1/fs:(length(L))/fs;
Spiketime.res=load ('Mouse17-130202.res.1','-ascii');
spkt=Spiketime.res/20000;% spkt0(EL) is time of spike in 20000 sample rate 
IND1 = nearestpoint(spkt,time,'nearest');% IND(EL) is the nearest sample of 1250 sample rate to each spike
mua1=zeros(1,length(time));
mua1(IND1)=1; % mua(EL) is a time vector that the spike times are 1 and the others are 0
ts=time(IND1);% ts(EL) is time of spikes in 1250 sample rate
[Mua1] =buz_channle(T1,T2,fs,mua1');
save Ch64.mat Ch64
save Ch57.mat Ch57
save Ch63.mat Ch63
save Ch58.mat Ch58
save Ch62.mat Ch62
save Ch59.mat Ch59
save Ch61.mat Ch61
save Ch60.mat Ch60
save Mua1.mat Mua1
% plot(time,ch8,'b',time,mua1*10^2.5,'r');

