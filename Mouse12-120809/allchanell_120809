%% Loading raw LFP data and extracting NREM episodes
% This script loads the complete 90-channel raw EEG recording from the
% Mouse12-120809 experiment at a sampling frequency of 1250 Hz. The EEG
% data are transposed and converted to double precision for subsequent
% processing, and the complete recording is saved as a MAT file.
%
% Predefined NREM/SWS time intervals are used to create a logical index
% corresponding to all NREM periods. The EEG samples within these
% intervals are extracted across all channels to produce an NREM-only EEG
% dataset.
%
% The resulting NREM EEG data are saved as a MAT file for subsequent sleep
% spindle and slow-oscillation analyses.

clear 
clc
close all
changeCurrentFolder('D:\daniel\Mouse12-120809')
%% read the .EEG file and save all channel

thal_allchanel_Mouse12_120809_new = bz_LoadBinary('Mouse12-120809.eeg','nChannels',90,'frequency',1250);
fs=1250;
save thal_allchanel_Mouse12_120809 -v7.3
OriginalData = thal_allchanel_Mouse12_120809_new;
%% creat NREM EPISOD

% load thal_allchanel_Mouse12_120806_new_90.mat
