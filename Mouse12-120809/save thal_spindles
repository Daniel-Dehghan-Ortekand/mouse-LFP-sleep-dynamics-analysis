%% Loading and organizing thalamic spindle data
% This script loads the detected sleep spindle data separately for each of
% 64 thalamic channels from the Mouse12-120809 recording.
%
% The spindle data from each channel are stored in a cell array, preserving
% the channel-specific spindle information for independent access and
% subsequent analysis.
%
% The complete collection of spindle data across all 64 channels is then
% saved as a MAT file for further processing.

clc 
clear 
close all 
%%

% pathsthal = dir('*/thal_spindles_ch*');


for k=1:64
% 
%     filename = strcat(pathsthal(k).folder, filesep, pathsthal(k).name); % Use filesep instead of just '/'
%     data = load(filename);
       data= load(['thal_spindles_120809_ch' num2str(k)]); 
      thal_spindles{k} = data;
%     save(['thal_spindles' num2str(k)], 'thal_spindles', '-v7.3');
%         clear data

end
save thal_spindles4.mat thal_spindles
