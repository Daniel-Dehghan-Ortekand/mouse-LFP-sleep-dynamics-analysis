%% Converting spike times to a matrix and extracting NREM spikes
% This script loads the detected spike times for all recorded cells from
% the Mouse12-120809 experiment and determines the maximum number of spikes
% among the cells. The cell-based spike-time data are then converted into a
% zero-padded matrix, where each column represents one cell and each row
% corresponds to a spike time. The resulting matrix is saved for subsequent
% analysis.
%
% The predefined NREM/SWS episode time intervals are used to create a
% logical index corresponding to all NREM periods. Spike times from each
% cell are mapped to the nearest EEG recording sample and converted into a
% binary spike-train representation.
%
% The spike trains are subsequently restricted to the NREM/SWS periods,
% producing a matrix containing the spike activity of all recorded cells
% exclusively during NREM episodes. The resulting NREM spike-train matrix
% is saved for subsequent neuronal activity analysis.

clear 
close all
tic
%% 
load    Mouse12-120809.spikes.cellinfo.mat
CellNum = size(spikes.times ,2);
%choose the longest length for Cell array 
MaxLen = 0;
for j=1:CellNum
    if length(spikes.times{1,j})>MaxLen
        MaxLen = length((spikes.times{1,j}));
    end
end  

% exclude spikes times from cell array to a matrix
SpikesTimesAllCells = zeros(MaxLen,CellNum);
for i=1:CellNum
 SpikesTimesAllCells(1:length(spikes.times{:,i}),i) = cell2mat(spikes.times(:,i));
end 

%save data 
save    SpikesTimesAllCells120809.mat SpikesTimesAllCells

