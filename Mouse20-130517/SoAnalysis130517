for i=1:ch_number
    thal_ch_norm(i,:)=zscore(SWS_episode(i,:));
end
%     save thal_ch_norm.mat thal_ch_norm -v7.3
thal_ch_norm_filtered_so=zeros(ch_number,length(SWS_episode(1,:)));
for j=1:ch_number
    disp (j)
thal_ch_norm_filtered_so(j,:) = eegfilt(thal_ch_norm(j,:),fs,down_freq,up_freq,0,floor(fs/down_freq)*3,0,'fir1');
end
