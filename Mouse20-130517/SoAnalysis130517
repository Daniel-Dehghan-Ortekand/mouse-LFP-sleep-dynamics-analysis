% exclude bad channels 
k= [42:48 64];
SWS_episode = SWS_episode(1:64,:);
SWS_episode(k,:) =[] ;
ch_number = size(SWS_episode, 1);
figure
hold on 
for i=1:ch_number
plot(zscore(SWS_episode(i,:))+10*i)
end
%

SWS_episode_neat130517.SWS_episode = SWS_episode;
SWS_episode_neat130517.excludedChannels =  k;
