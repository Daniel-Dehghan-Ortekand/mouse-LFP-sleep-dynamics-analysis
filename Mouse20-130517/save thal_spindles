%     data = load(filename);
       data= load(['thal_spindles_130517_ch' num2str(k)]); 
      thal_spindles{k} = data;
%     save(['thal_spindles' num2str(k)], 'thal_spindles', '-v7.3');
%         clear data

end
save thal_spindles16.mat thal_spindles
