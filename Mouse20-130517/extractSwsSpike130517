
%% Converting spike times to a matrix and extracting NREM spikes
% This script loads the detected spike times for all recorded cells and
% determines the maximum number of spikes among the cells. The
% cell-based spike-time data are then converted into a zero-padded matrix,
% where each column represents one cell and each row corresponds to a spike
% time. The resulting matrix is saved for subsequent analysis.
%
% The script then loads the predefined NREM/SWS episode time intervals and
% creates a sample-based logical index corresponding to these episodes.
% Spike times from each cell are mapped to the nearest EEG recording sample
% and converted into a binary spike-train representation. The spike trains
% are subsequently restricted to the NREM/SWS periods, producing a matrix
% containing spike activity from all cells exclusively during NREM episodes.
% The resulting NREM spike-train matrix is saved for further analysis.

clc
clear 
close all
tic
%% 
load    Mouse20-130517.spikes.cellinfo.mat
CellNum = size(spikes.times ,2);
%choose the longest length for Cell array 
MaxLen = 0;
for j=1:CellNum
    if length(spikes.times{1,j})>MaxLen
        MaxLen = length((spikes.times{1,j}));
    end
end  

% exclude spikes times from cell array to a matrix
SpikesTimesAllCells = zeros(MaxLen,CellNum);
for i=1:CellNum
 SpikesTimesAllCells(1:length(spikes.times{:,i}),i) = cell2mat(spikes.times(:,i));
end 

%save data 
save    SpikesTimesAllCells130517.mat SpikesTimesAllCells

%%
load    SpikesTimesAllCells130517.mat
load Sws_Time_130517.mat

fs = 1250;
%% main code 
ChCell = size(SpikesTimesAllCells ,2);
SwsEpisodeNum = size(SwsTime,1);

mf = matfile("thal_allchanel_Mouse20-130517.mat");
all_size = size(mf, "thal_allchanel_Mouse20_130517_new", 1);
all_time = (0:all_size-1)/fs;

SWS_ind = false(1, all_size);
for i=1:SwsEpisodeNum
    start_sample = round(SwsTime(i,1)*fs);
    stop_sample = round(SwsTime(i,2)*fs);
    SWS_ind(start_sample:stop_sample) = 1;
end

spikes_sws = false(ChCell, sum(SWS_ind));
for i=1:ChCell
    ind = nearestpoint(SpikesTimesAllCells(:,i), all_time);
    s = false(1, all_size);
    s(ind) = 1;

    spikes_sws(i, :) = s(SWS_ind);

end
save SpikesSWS130517.mat spikes_sws

toc
